/ The Sahaj Atlas embed: SahajAtlasWeb docs/embedding.md is its contract.
/ The map fills what the header leaves of the window, as a flex item, so it
/ never runs below the fold.
css:
  body { display: flex; flex-direction: column; height: 100vh; height: 100dvh; margin: 0; }
  sahaj-atlas { display: block; flex: 1 1 0; min-height: 0; }

script type="module" src="https://sahajatlas.com/auto.js?key=#{ENV.fetch('ATLAS_KEY')}"
sahaj-atlas
